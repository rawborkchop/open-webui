# Copy to config/openrouter/.env. This template contains no credentials.
OPENAI_API_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=
ENABLE_OPENAI_API=true
ENABLE_OLLAMA_API=false
ENABLE_DIRECT_CONNECTIONS=false
# Keep admin settings and permissions across restarts.
ENABLE_PERSISTENT_CONFIG=true
WEBUI_AUTH=true
OPENROUTER_STRICT_USER_ISOLATION=true
ENABLE_SIGNUP=true
DEFAULT_USER_ROLE=pending
# The existing admin role serves as superadmin.
ENABLE_ADMIN_CHAT_ACCESS=true
ENABLE_ADMIN_EXPORT=true
ENABLE_ADMIN_WORKSPACE_CONTENT_ACCESS=true
BYPASS_ADMIN_ACCESS_CONTROL=true
# Preserve the generated application secret in the data volume.
WEBUI_SECRET_KEY=
WEBUI_SECRET_KEY_FILE=/app/backend/data/.webui_secret_key
# Initial permissions for a private, persistent chat installation.
USER_PERMISSIONS_CHAT_SHARE=false
USER_PERMISSIONS_CHAT_ALLOW_PUBLIC_SHARING=false
USER_PERMISSIONS_CHAT_ALLOW_OPEN_SHARING=false
ENABLE_COMMUNITY_SHARING=false
USER_PERMISSIONS_CHAT_TEMPORARY=false
USER_PERMISSIONS_CHAT_TEMPORARY_ENFORCED=false
USER_PERMISSIONS_CHAT_DELETE=false
USER_PERMISSIONS_CHAT_DELETE_MESSAGE=false
USER_PERMISSIONS_CHAT_PARAMS=false
USER_PERMISSIONS_CHAT_SYSTEM_PROMPT=false
USER_PERMISSIONS_FEATURES_CHANNELS=false
# Operational audit only; full provider payload persistence is planned separately.
AUDIT_LOG_LEVEL=METADATA
ENABLE_AUDIT_LOGS_FILE=true
DO_NOT_TRACK=true
SCARF_NO_ANALYTICS=true
ANONYMIZED_TELEMETRY=false
